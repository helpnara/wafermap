# Data — 원본/중간 산출물은 커밋하지 않음 (data/sample 만 예외)
data/raw/
data/interim/
data/processed/

# Models — 배포용 소형 아티팩트는 커밋한다(클라우드에서 학습 없이 로드, §4.3).
# 실측(real) 모델은 용량이 커질 수 있어 제외.
models/real/
models/*.pkl
!models/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / Editor
.DS_Store
.idea/

# VS Code — 팀 공용 설정(인터프리터 경로, 권장 확장, 실행 구성)은 커밋한다.
# 개인 설정(테마·창 배치 등)은 각자 사용자 설정에 두면 되므로 나머지는 제외.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# Streamlit
.streamlit/secrets.toml

# 가상환경
.venv/
